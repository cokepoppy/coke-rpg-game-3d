{
  "name": "cangshan-rpg",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "3d:dev": "vite --host 127.0.0.1 --port 5180",
    "3d:build": "vite build --config vite.three.config.mjs && node tools/copy-threejs-assets.mjs",
    "3d:character:build": "blender -b --python tools/package_wuxia_pants_character.py",
    "3d:character:inspect": "node scripts/inspect-cangshan-character-actions.mjs",
    "3d:demo:record": "node scripts/record-cangshan-3d-demo.mjs",
    "seedance:submit": "node scripts/seedance-submit.mjs",
    "wechat:assets": "node scripts/copy-wechat-assets.mjs",
    "wechat:debug": "npm run wechat:assets && node scripts/start-wechat-debug.mjs",
    "wechat:boss:demo": "node scripts/demo-wechat-boss.mjs",
    "wechat:romance:demo": "node scripts/demo-wechat-romance.mjs",
    "wechat:test": "node scripts/test-wechat-debug.mjs",
    "wechat:menu:test": "node scripts/test-wechat-menu.mjs",
    "wechat:battle:test": "node scripts/test-wechat-battle.mjs",
    "wechat:boss:test": "node scripts/test-wechat-bosses.mjs",
    "wechat:battle:skills:test": "node scripts/test-wechat-battle-skills.mjs",
    "wechat:battle:actions:test": "node scripts/test-wechat-battle-actions.mjs",
    "wechat:map:debug": "node scripts/test-wechat-map-debug.mjs",
    "wechat:moon:test": "node scripts/test-wechat-moon-valley.mjs",
    "wechat:romance:test": "node scripts/test-wechat-romance.mjs",
    "story:campaign:test": "node scripts/test-story-campaign.mjs",
    "wechat:worldmap:test": "node scripts/test-wechat-worldmap.mjs",
    "wechat:inventory:test": "node scripts/test-wechat-inventory.mjs",
    "wechat:shop:test": "node scripts/test-wechat-shop.mjs",
    "wechat:cutscene:test": "node scripts/test-wechat-cutscene.mjs",
    "wechat:devtools:cutscene:test": "node scripts/test-wechat-devtools-cutscene.mjs",
    "pages:build": "npm run wechat:assets && node scripts/build-pages.mjs",
    "wechat:open": "npm run wechat:assets && /Applications/wechatwebdevtools.app/Contents/MacOS/cli open --project $PWD/wechat-minigame --lang zh",
    "wechat:preview": "npm run wechat:assets && /Applications/wechatwebdevtools.app/Contents/MacOS/cli preview --project $PWD/wechat-minigame --lang zh"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "playwright-core": "^1.60.0",
    "sharp": "^0.35.1",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}

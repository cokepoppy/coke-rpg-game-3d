  "dialogs": [
    {
      "name": "world-moon-gate-dialog",
      "speaker": "月华谷山口",
      "text": "雾气从竹林深处涌出，石阶尽头隐约有灯火。",
      "choices": [
        "进入月华谷",
        "暂时离开"
      ]
    },
    {
      "name": "moon-valley-arrival-1",
      "speaker": "月华谷弟子",
      "text": "谷主失踪后，外人不得入药庐。你们若要查旧信，先证明不是南岭王府派来的。",
      "choices": []
    },
    {
      "name": "qin-wanyao-dialog",
      "speaker": "秦晚瑶",
      "text": "谷中药账被人改过，少侠若要追查旧案，先从书房残图看起。这封王府请帖，也许能让你问到更深的真相。",
      "choices": [
        "收下王府请帖",
        "请她配些伤药"
      ]
    },
    {
      "name": "qin-wanyao-invitation",
      "choices": []
    },
    {
      "name": "mu-zhiyan-dialog",
      "speaker": "穆芷烟",
      "text": "昨夜有人从桥后翻入药圃，只留下半枚青铜扣。那人应还藏在谷中。被调包的孩子，也许不止你以为的那一个。",
      "choices": [
        "记下调包线索",
        "暂时离开"
      ]
    },
    {
      "name": "mu-zhiyan-clue",
      "choices": []
    },
    {
      "name": "medicine-door-dialog",
      "speaker": "月华药庐",
      "text": "药香透过门缝散出，里面有人正在研磨草药。",
      "choices": [
        "进入药庐",
        "暂时离开"
      ]
    },
    {
      "name": "study-door-dialog",
      "speaker": "月华书房",
      "text": "窗内灯影未灭，案上似乎摊着一卷残图。",
      "choices": [
        "进入书房",
        "暂时离开"
      ]
    },
    {
      "name": "moon-scout-dialog",
      "speaker": "谷中叛徒",
      "text": "你不该来月华谷。残图和药账，都得留在这里。",
      "choices": [
        "拔剑迎战",
        "暂避锋芒"
      ]
    }
  ],
